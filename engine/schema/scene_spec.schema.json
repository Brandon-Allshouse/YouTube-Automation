    "SceneSpec": {
      "additionalProperties": false,
      "description": "One shot.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9_-]{1,32}$",
          "title": "Id",
          "type": "string"
        },
        "start": {
          "maximum": 1200.0,
          "minimum": 0.0,
          "title": "Start",
          "type": "number"
        },
        "transition": {
          "anyOf": [
            {
              "$ref": "#/$defs/TransitionSpecModel"
            },
            {
              "const": "theme",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "theme",
          "title": "Transition"
        },
        "elements": {
          "items": {
            "discriminator": {
              "mapping": {
                "AnimatedMap": "#/$defs/AnimatedMapSpec",
                "BarRace": "#/$defs/BarRaceSpec",
                "ComparisonSplit": "#/$defs/ComparisonSplitSpec",
                "DiagramBuild": "#/$defs/DiagramBuildSpec",
                "IconScene": "#/$defs/IconSceneSpec",
                "KineticTitle": "#/$defs/KineticTitleSpec",
                "LineChartReveal": "#/$defs/LineChartRevealSpec",
                "ListReveal": "#/$defs/ListRevealSpec",
                "ParticleBackground": "#/$defs/ParticleBackgroundSpec",
                "QuoteCard": "#/$defs/QuoteCardSpec",
                "StatCounter": "#/$defs/StatCounterSpec",
                "Timeline": "#/$defs/TimelineSpec"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/KineticTitleSpec"
              },
              {
                "$ref": "#/$defs/StatCounterSpec"
              },
              {
                "$ref": "#/$defs/ListRevealSpec"
              },
              {
                "$ref": "#/$defs/QuoteCardSpec"
              },
              {
                "$ref": "#/$defs/ComparisonSplitSpec"
              },
              {
                "$ref": "#/$defs/LineChartRevealSpec"
              },
              {
                "$ref": "#/$defs/BarRaceSpec"
              },
              {
                "$ref": "#/$defs/TimelineSpec"
              },
              {
                "$ref": "#/$defs/AnimatedMapSpec"
              },
              {
                "$ref": "#/$defs/DiagramBuildSpec"
              },
              {
                "$ref": "#/$defs/IconSceneSpec"
              },
              {
                "$ref": "#/$defs/ParticleBackgroundSpec"
              }
            ]
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Elements",
          "type": "array"
        },
        "camera_drift": {
          "anyOf": [
            {
              "maximum": 0.2,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Camera Drift"
        },
        "note": {
          "default": "",
          "maxLength": 200,
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "id",
        "start",
        "elements"
      ],
      "title": "SceneSpec",
      "type": "object"
    },
