        "start": {
          "default": 0.0,
          "maximum": 1200.0,
          "minimum": 0.0,
          "title": "Start",
          "type": "number"
        },
        "end": {
          "anyOf": [
            {
              "maximum": 1200.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "region": {
          "default": "full",
          "enum": [
            "full",
            "center",
            "upper",
            "lower",
            "top",
            "left",
            "right"
          ],
          "title": "Region",
          "type": "string"
        },
        "type": {
          "const": "ParticleBackground",
