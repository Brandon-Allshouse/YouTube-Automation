        "start": {
          "default": 0.0,
          "maximum": 1200.0,
          "minimum": 0.0,
          "title": "Start",
          "type": "number"
        },
        "end": {
          "anyOf": [
            {
              "maximum": 1200.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "region": {
          "default": "center",
          "enum": [
            "full",
            "center",
            "upper",
            "lower",
            "top",
            "left",
            "right"
          ],
          "title": "Region",
          "type": "string"
        },
        "type": {
          "const": "StatCounter",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "maximum": 1000000000000000.0,
          "minimum": -1000000000000000.0,
          "title": "Value",
          "type": "number"
        },
        "from_value": {
          "default": 0.0,
          "maximum": 1000000000000000.0,
          "minimum": -1000000000000000.0,
          "title": "From Value",
          "type": "number"
        },
        "decimals": {
          "default": 0,
          "maximum": 3,
          "minimum": 0,
          "title": "Decimals",
          "type": "integer"
        },
        "prefix": {
          "default": "",
          "maxLength": 4,
          "title": "Prefix",
          "type": "string"
        },
        "suffix": {
          "default": "",
          "maxLength": 12,
          "title": "Suffix",
          "type": "string"
        },
        "label": {
          "default": "",
          "maxLength": 48,
          "title": "Label",
          "type": "string"
        },
        "count_duration": {
          "default": 1.6,
          "exclusiveMinimum": 0,
          "maximum": 6,
          "title": "Count Duration",
          "type": "number"
        },
        "count_at": {
          "anyOf": [
            {
              "maximum": 1200.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Count At"
        },
        "ring": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
