      "type": "object"
    },
    "TimelineEventSpec": {
      "additionalProperties": false,
      "description": "A dated event on a timeline.",
      "properties": {
        "date": {
          "maxLength": 14,
          "minLength": 1,
          "title": "Date",
          "type": "string"
        },
        "label": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "date",
        "label"
      ],
      "title": "TimelineEventSpec",
      "type": "object"
    },
    "TimelineSpec": {
      "additionalProperties": false,
      "description": "Horizontal/vertical timeline whose events pop in along a drawing line.",
      "properties": {
        "start": {
          "default": 0.0,
          "maximum": 1200.0,
          "minimum": 0.0,
          "title": "Start",
          "type": "number"
        },
        "end": {
          "anyOf": [
            {
              "maximum": 1200.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "region": {
          "default": "center",
          "enum": [
            "full",
            "center",
            "upper",
            "lower",
            "top",
            "left",
            "right"
          ],
          "title": "Region",
          "type": "string"
        },
        "type": {
          "const": "Timeline",
          "title": "Type",
          "type": "string"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/TimelineEventSpec"
          },
          "maxItems": 7,
          "minItems": 2,
          "title": "Events",
          "type": "array"
        },
        "interval": {
          "default": 0.8,
          "exclusiveMinimum": 0,
          "maximum": 10,
          "title": "Interval",
          "type": "number"
        },
        "highlight": {
          "default": -1,
          "maximum": 6,
          "minimum": -1,
          "title": "Highlight",
          "type": "integer"
        }
      },
      "required": [
        "type",
        "events"
      ],
      "title": "TimelineSpec",
      "type": "object"
    },
    "TransitionSpecModel": {
      "additionalProperties": false,
      "description": "Transition into a scene (defaults to the theme's).",
      "properties": {
        "kind": {
          "default": "wipe",
          "enum": [
            "wipe",
            "zoom",
            "slide",
            "glitch",
            "fade",
            "iris",
            "cut"
          ],
          "title": "Kind",
          "type": "string"
        },
        "duration": {
          "default": 0.45,
          "exclusiveMinimum": 0,
          "maximum": 2,
          "title": "Duration",
          "type": "number"
        },
        "easing": {
          "default": "in_out_expo",
          "title": "Easing",
          "type": "string"
        }
      },
      "title": "TransitionSpecModel",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A complete video spec (spec + theme + seed fully determine the frames).",
  "properties": {
    "version": {
      "const": 1,
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Id",
      "type": "string"
    },
    "format": {
      "enum": [
        "short",
        "long"
      ],
      "title": "Format",
      "type": "string"
    },
    "theme": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Theme",
      "type": "string"
    },
    "seed": {
      "default": 0,
      "maximum": 2147483647,
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "fps": {
      "default": 30,
      "enum": [
        24,
        25,
        30,
        60
      ],
      "title": "Fps",
      "type": "integer"
    },
    "duration": {
      "exclusiveMinimum": 0,
      "title": "Duration",
      "type": "number"
    },
    "scenes": {
      "items": {
        "$ref": "#/$defs/SceneSpec"
      },
      "maxItems": 200,
      "minItems": 1,
      "title": "Scenes",
      "type": "array"
    },
    "captions": {
      "$ref": "#/$defs/CaptionsSpec",
      "default": {
        "enabled": true,
        "words": [],
        "mode": null
      }
    },
    "progress_bar": {
      "default": false,
      "title": "Progress Bar",
      "type": "boolean"
    },
    "motion_blur": {
      "default": 1,
      "maximum": 4,
      "minimum": 1,
      "title": "Motion Blur",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "format",
    "theme",
    "duration",
    "scenes"
  ],
  "title": "Scene spec (video-portfolio renderer)",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
