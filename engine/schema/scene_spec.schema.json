{
  "$defs": {
    "AnimatedMapSpec": {
      "additionalProperties": false,
      "description": "Natural Earth map: camera move, projection morph, highlights, true-size moves, routes, markers.",
      "properties": {
        "start": {
          "default": 0.0,
          "maximum": 1200.0,
          "minimum": 0.0,
          "title": "Start",
          "type": "number"
        },
        "end": {
          "anyOf": [
            {
              "maximum": 1200.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "region": {
          "default": "full",
          "enum": [
            "full",
            "center",
            "upper",
            "lower",
            "top",
            "left",
            "right"
          ],
          "title": "Region",
          "type": "string"
        },
        "type": {
          "const": "AnimatedMap",
          "title": "Type",
          "type": "string"
        },
        "projection": {
          "default": "mercator",
          "enum": [
            "mercator",
            "equal_earth",
            "equirect"
          ],
          "title": "Projection",
          "type": "string"
        },
        "morph_to": {
          "anyOf": [
            {
              "enum": [
                "mercator",
                "equal_earth",
                "equirect"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Morph To"
        },
        "morph_start": {
          "default": 0.5,
          "maximum": 1200.0,
          "minimum": 0.0,
          "title": "Morph Start",
          "type": "number"
        },
        "morph_duration": {
          "default": 2.5,
          "exclusiveMinimum": 0,
          "maximum": 10,
          "title": "Morph Duration",
          "type": "number"
        },
        "center_from": {
          "default": [
            0.0,
            20.0
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "maximum": 85,
              "minimum": -85,
              "type": "number"
            }
          ],
          "title": "Center From",
          "type": "array"
        },
        "center_to": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "maximum": 180,
                  "minimum": -180,
                  "type": "number"
                },
                {
                  "maximum": 85,
                  "minimum": -85,
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Center To"
        },
        "zoom_from": {
          "default": 1.0,
          "maximum": 60,
          "minimum": 0.5,
          "title": "Zoom From",
          "type": "number"
        },
        "zoom_to": {
          "anyOf": [
            {
              "maximum": 60,
              "minimum": 0.5,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Zoom To"
        },
        "move_start": {
          "default": 0.0,
          "maximum": 1200.0,
          "minimum": 0.0,
          "title": "Move Start",
          "type": "number"
        },
        "move_duration": {
          "default": 2.5,
          "exclusiveMinimum": 0,
          "maximum": 15,
          "title": "Move Duration",
          "type": "number"
        },
        "highlight": {
          "items": {
            "maxLength": 3,
            "minLength": 3,
            "pattern": "^[A-Z]{3}$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Highlight",
          "type": "array"
        },
        "highlight_continents": {
          "items": {
            "enum": [
              "Africa",
              "Europe",
              "Asia",
              "North America",
              "South America",
              "Oceania",
              "Antarctica"
            ],
            "type": "string"
          },
          "maxItems": 7,
          "title": "Highlight Continents",
          "type": "array"
        },
        "highlight_at": {
          "default": 0.6,
          "maximum": 1200.0,
          "minimum": 0.0,
          "title": "Highlight At",
          "type": "number"
        },
        "moves": {
          "items": {
            "$ref": "#/$defs/MapMoveSpec"
          },
          "maxItems": 4,
          "title": "Moves",
          "type": "array"
        },
        "paths": {
          "items": {
            "$ref": "#/$defs/MapPathSpec"
          },
          "maxItems": 5,
          "title": "Paths",
          "type": "array"
        },
        "markers": {
          "items": {
            "$ref": "#/$defs/MapMarkerSpec"
          },
          "maxItems": 10,
          "title": "Markers",
          "type": "array"
        },
        "graticule": {
          "default": true,
          "title": "Graticule",
          "type": "boolean"
        },
        "resolution": {
          "default": "50m",
          "enum": [
            "50m",
            "110m"
          ],
          "title": "Resolution",
          "type": "string"
        },
        "title": {
          "default": "",
          "maxLength": 40,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "AnimatedMapSpec",
      "type": "object"
    },
    "BarRaceSpec": {
      "additionalProperties": false,
      "description": "Animated ranking bars over time.",
      "properties": {
        "start": {
          "default": 0.0,
          "maximum": 1200.0,
          "minimum": 0.0,
          "title": "Start",
          "type": "number"
        },
        "end": {
          "anyOf": [
            {
              "maximum": 1200.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "region": {
          "default": "center",
          "enum": [
            "full",
            "center",
            "upper",
            "lower",
            "top",
            "left",
            "right"
          ],
          "title": "Region",
          "type": "string"
        },
        "type": {
          "const": "BarRace",
          "title": "Type",
          "type": "string"
        },
        "title": {
          "default": "",
          "maxLength": 48,
          "title": "Title",
          "type": "string"
        },
        "labels": {
          "items": {
            "maxLength": 18,
            "type": "string"
          },
          "maxItems": 12,
          "minItems": 2,
          "title": "Labels",
          "type": "array"
        },
        "frames": {
          "items": {
            "items": {
              "maximum": 1000000000000000.0,
              "minimum": 0,
              "type": "number"
            },
            "type": "array"
          },
          "maxItems": 40,
          "minItems": 1,
          "title": "Frames",
          "type": "array"
        },
        "frame_labels": {
          "items": {
            "maxLength": 10,
            "type": "string"
          },
          "maxItems": 40,
          "title": "Frame Labels",
          "type": "array"
        },
        "seconds_per_frame": {
          "default": 1.2,
          "exclusiveMinimum": 0.2,
          "maximum": 10,
          "title": "Seconds Per Frame",
          "type": "number"
        },
        "top_n": {
          "default": 6,
          "maximum": 10,
          "minimum": 2,
          "title": "Top N",
          "type": "integer"
        },
        "value_suffix": {
          "default": "",
          "maxLength": 6,
          "title": "Value Suffix",
          "type": "string"
        }
      },
      "required": [
        "type",
        "labels",
        "frames"
      ],
      "title": "BarRaceSpec",
      "type": "object"
    },
    "CaptionWord": {
      "additionalProperties": false,
      "description": "A spoken word with timing (seconds, global).",
      "properties": {
        "w": {
          "maxLength": 40,
          "minLength": 1,
          "title": "W",
          "type": "string"
        },
        "start": {
          "maximum": 1200.0,
          "minimum": 0.0,
          "title": "Start",
          "type": "number"
        },
        "end": {
          "maximum": 1200.0,
          "minimum": 0.0,
          "title": "End",
          "type": "number"
        },
        "emph": {
          "default": false,
          "title": "Emph",
          "type": "boolean"
        }
      },
      "required": [
        "w",
        "start",
        "end"
      ],
      "title": "CaptionWord",
      "type": "object"
    },
    "CaptionsSpec": {
      "additionalProperties": false,
      "description": "Word-level captions overlay.",
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "words": {
          "items": {
            "$ref": "#/$defs/CaptionWord"
          },
          "maxItems": 6000,
          "title": "Words",
          "type": "array"
        },
        "mode": {
          "anyOf": [
            {
              "enum": [
                "pop",
                "karaoke",
                "box"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode"
        }
      },
      "title": "CaptionsSpec",
      "type": "object"
    },
    "ComparisonSide": {
      "additionalProperties": false,
      "description": "One side of a comparison.",
      "properties": {
        "label": {
          "maxLength": 24,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "value": {
          "maximum": 1000000000000000.0,
          "minimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "label",
        "value"
      ],
      "title": "ComparisonSide",
      "type": "object"
    },
    "ComparisonSplitSpec": {
      "additionalProperties": false,
      "description": "Two quantities drawn to honest scale (area-true squares or bars).",
      "properties": {
        "start": {
          "default": 0.0,
          "maximum": 1200.0,
          "minimum": 0.0,
          "title": "Start",
          "type": "number"
        },
        "end": {
          "anyOf": [
            {
              "maximum": 1200.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "region": {
          "default": "center",
          "enum": [
            "full",
            "center",
            "upper",
            "lower",
            "top",
            "left",
            "right"
          ],
          "title": "Region",
          "type": "string"
        },
        "type": {
          "const": "ComparisonSplit",
          "title": "Type",
          "type": "string"
        },
        "left": {
          "$ref": "#/$defs/ComparisonSide"
        },
        "right": {
          "$ref": "#/$defs/ComparisonSide"
        },
        "unit": {
          "default": "",
          "maxLength": 8,
          "title": "Unit",
          "type": "string"
        },
        "mode": {
          "default": "area",
          "enum": [
            "area",
            "bar"
          ],
          "title": "Mode",
          "type": "string"
        },
        "decimals": {
          "default": 1,
          "maximum": 2,
          "minimum": 0,
          "title": "Decimals",
          "type": "integer"
        },
        "compact": {
          "default": true,
          "title": "Compact",
          "type": "boolean"
        },
        "show_ratio": {
          "default": true,
          "title": "Show Ratio",
          "type": "boolean"
        },
        "stagger": {
          "default": 0.35,
          "maximum": 3,
          "minimum": 0,
          "title": "Stagger",
          "type": "number"
        }
      },
      "required": [
        "type",
        "left",
        "right"
      ],
      "title": "ComparisonSplitSpec",
      "type": "object"
    },
    "DiagramBuildSpec": {
      "additionalProperties": false,
      "description": "Nodes and arrows building step by step.",
      "properties": {
        "start": {
          "default": 0.0,
          "maximum": 1200.0,
          "minimum": 0.0,
          "title": "Start",
          "type": "number"
        },
        "end": {
          "anyOf": [
            {
              "maximum": 1200.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "region": {
          "default": "center",
          "enum": [
            "full",
            "center",
            "upper",
            "lower",
            "top",
            "left",
            "right"
          ],
          "title": "Region",
          "type": "string"
        },
        "type": {
          "const": "DiagramBuild",
          "title": "Type",
          "type": "string"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/DiagramNodeSpec"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Nodes",
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/DiagramEdgeSpec"
          },
          "maxItems": 16,
          "title": "Edges",
          "type": "array"
        }
      },
      "required": [
        "type",
        "nodes"
      ],
      "title": "DiagramBuildSpec",
      "type": "object"
    },
    "DiagramEdgeSpec": {
      "additionalProperties": false,
      "description": "Arrow between two diagram nodes.",
      "properties": {
        "src": {
          "pattern": "^[a-z0-9_]{1,20}$",
          "title": "Src",
          "type": "string"
        },
        "dst": {
          "pattern": "^[a-z0-9_]{1,20}$",
          "title": "Dst",
          "type": "string"
        },
        "label": {
          "default": "",
          "maxLength": 20,
          "title": "Label",
          "type": "string"
        },
        "at": {
          "default": 0.0,
          "maximum": 1200.0,
          "minimum": 0.0,
          "title": "At",
          "type": "number"
        }
      },
      "required": [
        "src",
        "dst"
      ],
      "title": "DiagramEdgeSpec",
      "type": "object"
    },
    "DiagramNodeSpec": {
      "additionalProperties": false,
      "description": "Diagram node in a 0-1 layout grid.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9_]{1,20}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 28,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "x": {
          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        },
        "at": {
          "default": 0.0,
          "maximum": 1200.0,
          "minimum": 0.0,
          "title": "At",
          "type": "number"
        },
        "accent": {
          "default": false,
          "title": "Accent",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "label",
        "x",
        "y"
      ],
      "title": "DiagramNodeSpec",
      "type": "object"
    },
    "IconSceneSpec": {
      "additionalProperties": false,
