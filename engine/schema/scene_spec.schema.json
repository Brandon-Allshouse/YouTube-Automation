    "ListRevealSpec": {
      "additionalProperties": false,
      "description": "Up to 6 items revealed one by one; earlier items dim to keep focus.",
      "properties": {
        "start": {
          "default": 0.0,
          "maximum": 1200.0,
          "minimum": 0.0,
          "title": "Start",
          "type": "number"
        },
        "end": {
          "anyOf": [
            {
              "maximum": 1200.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "region": {
          "default": "center",
          "enum": [
            "full",
            "center",
            "upper",
            "lower",
            "top",
            "left",
            "right"
          ],
          "title": "Region",
          "type": "string"
        },
        "type": {
          "const": "ListReveal",
          "title": "Type",
          "type": "string"
        },
        "title": {
          "default": "",
          "maxLength": 40,
          "title": "Title",
          "type": "string"
