          "default": "",
          "maxLength": 24,
          "title": "Name",
          "type": "string"
        },
        "values": {
          "items": {
            "maximum": 1000000000000.0,
            "minimum": -1000000000000.0,
            "type": "number"
          },
          "maxItems": 60,
          "minItems": 2,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "values"
      ],
      "title": "SeriesSpec",
      "type": "object"
    },
    "StatCounterSpec": {
      "additionalProperties": false,
