            "bolt",
            "coin",
            "ship",
            "mountain",
            "atom",
            "chart",
            "warning",
            "crown",
            "book",
            "flame"
          ],
          "title": "Icon",
          "type": "string"
        },
        "label": {
          "default": "",
          "maxLength": 32,
          "title": "Label",
          "type": "string"
        },
        "accent": {
          "default": true,
          "title": "Accent",
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "icon"
      ],
      "title": "IconSceneSpec",
      "type": "object"
    },
    "KineticTitleSpec": {
