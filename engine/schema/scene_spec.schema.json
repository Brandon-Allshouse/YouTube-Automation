            "type": "array"
          },
          "maxItems": 50,
          "minItems": 2,
          "title": "Points",
          "type": "array"
        },
        "start": {
          "default": 0.5,
          "maximum": 1200.0,
          "minimum": 0.0,
          "title": "Start",
          "type": "number"
        },
        "duration": {
          "default": 2.0,
          "exclusiveMinimum": 0,
          "maximum": 15,
          "title": "Duration",
          "type": "number"
        }
      },
      "required": [
        "points"
      ],
      "title": "MapPathSpec",
      "type": "object"
    },
    "ParticleBackgroundSpec": {
      "additionalProperties": false,
