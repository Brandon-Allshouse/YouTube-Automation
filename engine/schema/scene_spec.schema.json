        "start": {
          "default": 0.0,
          "maximum": 1200.0,
          "minimum": 0.0,
          "title": "Start",
          "type": "number"
        },
        "end": {
          "anyOf": [
            {
              "maximum": 1200.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
