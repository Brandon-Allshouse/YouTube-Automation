{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Write(./data/**)",
      "Edit(./data/**)",
      "Bash(bash scripts/task.sh test)",
      "Bash(bash scripts/task.sh test-all)",
      "Bash(bash scripts/task.sh coverage)",
      "Bash(bash scripts/task.sh lint:*)",
      "Bash(bash scripts/task.sh typecheck:*)",
      "Bash(bash scripts/task.sh quality:*)",
      "Bash(bash scripts/task.sh research:*)",
      "Bash(bash scripts/task.sh analytics:*)",
      "Bash(bash scripts/task.sh learn:*)",
      "Bash(bash scripts/task.sh produce:*)",
      "Bash(bash scripts/task.sh thumbnails:*)",
      "Bash(bash scripts/task.sh validate-spec:*)",
      "Bash(bash scripts/task.sh distinctness:*)",
      "Bash(bash scripts/task.sh inspect:*)",
      "Bash(bash scripts/task.sh render-demo:*)",
      "Bash(bash scripts/task.sh db list:*)",
      "Bash(bash scripts/task.sh db get:*)",
      "Bash(bash scripts/task.sh db add-video:*)",
      "Bash(bash scripts/task.sh db transition:*)",
      "Bash(bash scripts/task.sh db quota:*)",
      "Bash(bash scripts/task.sh review list:*)",
      "Bash(bash scripts/task.sh review show:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Read(./**)",
      "Glob(./**)",
      "Grep(./**)",
      "Bash(bash scripts/task.sh timing --video-id:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/client_secret*.json)",
      "Read(**/token*.json)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.docker/**)",
      "Edit(./.env)",
      "Edit(./CLAUDE.md)",
      "Edit(./config/rules.yaml)",
      "Edit(./.claude/settings.json)",
      "Edit(./.github/**)",
      "Write(./.env)",
      "Write(./.claude/settings.json)",
      "Bash(bash scripts/task.sh publish:*)",
      "Bash(bash scripts/task.sh review approve:*)",
      "Bash(bash scripts/task.sh run:*)",
      "Bash(bash scripts/task.sh shell:*)",
      "Bash(bash scripts/task.sh lock:*)",
      "Bash(bash scripts/task.sh fetch-assets:*)",
      "Bash(docker:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(pip install:*)",
      "Bash(npm install:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git checkout:*)",
      "Bash(git clean:*)",
      "Bash(python -m src.publish.youtube:*)",
      "Bash(python -m src.review.queue approve:*)",
      "Bash(bash scripts/task.sh oauth:*)",
      "Bash(python -m src.publish.oauth:*)",
      "Read(~/.config/video-portfolio/**)",
      "Read(~/.claude/**)",
      "Read(**/*secret*.json)",
      "Read(**/oauth/**)",
      "Edit(./src/**)",
      "Edit(./engine/**)",
      "Edit(./scripts/**)",
      "Edit(./tests/**)",
      "Edit(./config/**)",
      "Edit(./.claude/**)",
      "Edit(./Dockerfile)",
      "Edit(./docker-compose.yml)",
      "Write(./src/**)",
      "Write(./engine/**)",
      "Write(./scripts/**)",
      "Write(./tests/**)",
      "Write(./config/**)",
      "Write(./.claude/**)",
      "Bash(bash scripts/task.sh timing * --schedule*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(bash -c:*)",
      "Bash(sh -c:*)"
    ],
    "ask": [
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ]
  }
}